#!/bin/bash

loopback="${1:-127.0.0.1}"

# validate that the provided loopback is a valid IPv4 address
if ! [[ "$loopback" =~ ^127\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    echo "Error: Invalid loopback address. Must be in the 127.x.x.x range."
    exit 1
fi

# open /dev/ttyGS2 for reading (FD 3) and writing (FD 4)
exec 3</dev/ttyGS2
exec 4>/dev/ttyGS2

# start j1708dump in a subshell that ignores SIGPIPE,
# filter its output to only show the bytes (assuming they're in the 3rd column),
# and write to /dev/ttyGS2.
( trap '' SIGPIPE; j1708dump --show-checksums | awk '{print $3}' ) >&4 &
dump_pid=$!

# kill the background dump process and clean up on exit
cleanup() {
    kill "$dump_pid" 2>/dev/null
    sudo ip link del dummy0 2>/dev/null
    exit
}
trap cleanup SIGINT SIGTERM

# read input from /dev/ttyGS2 and forward it to j1708send for checksum validation
while IFS= read -r line <&3; do
    # valid hex for j1708dump is 0-9, A-F, a-f
    if [[ "$line" =~ ^[0-9A-Fa-f]+$ ]]; then
        j1708send --truckduck-host "$loopback" "$line"
    else
        echo "Invalid hex input: $line" >&2
    fi
done

cleanup