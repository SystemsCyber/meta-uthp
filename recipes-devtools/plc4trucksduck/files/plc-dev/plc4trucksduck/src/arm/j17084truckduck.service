[Unit]
Description=J17084UTDuck Service
After=network.target remoteproc.target

[Service]
Type=simple
ExecStart=/usr/bin/j17084truckduck_host
Restart=on-failure
User=root
Environment=PYTHONUNBUFFERED=1
StandardOutput=file:/var/log/j17084truckduck.log
StandardError=file:/var/log/j17084truckduck-errors.log


[Install]
WantedBy=multi-user.target